def conexion_banxico(ruta: str):
    """
    Funcion 1: se conecta a banxico y comprueba la conectividad con el status
    Recibe la ruta que va despues de la url (serie y tipo de dato)
    Regresa la respuesta (response) si el status es 200, si no regresa None
    """
    headers = {"Bmx-Token": TOKEN}
    enlace = f"{URL_BANXICO}/{ruta}"
    try:
        response = requests.get(url=enlace, headers=headers, timeout=10)
    except requests.exceptions.ConnectionError:
        print("No hay conexion a internet o a banxico")
        return None
    except requests.exceptions.Timeout:
        print("Banxico tardo demasiado en responder")
        return None
    except requests.exceptions.RequestException as error:
        print(f"Error al hacer el request: {error}")
        return None

    print(f"Status de la conexion: {response.status_code}")
    if response.status_code == 200:
        return response
    elif response.status_code == 404:
        print("No se encontro la serie o no hay datos para esa consulta")
    elif response.status_code in (401, 403):
        print("Token invalido, revisa TOKEN_BANXICO en el archivo .env")
    else:
        print("Banxico respondio con un error")
    return None


def leer_respuesta(response, serie: str):
    """
    Funcion 2: lee la respuesta de banxico
    Recibe la respuesta (response) y la clave de la serie
    Regresa un diccionario con serie, titulo y datos (lista de fecha y dato)
    Si algo falla o no hay datos regresa None
    """
    try:
        info = response.json()["bmx"]["series"][0]
        datos = info.get("datos")
        if not datos:
            print("Banxico no tiene datos para esa consulta")
            return None
        return {"serie": serie, "titulo": info["titulo"], "datos": datos}
    except (ValueError, KeyError, IndexError):
        print("La respuesta de banxico no tiene el formato esperado")
        return None


def consultar_oportuno(serie: str):
    """
    Funcion 3: consulta una serie de banxico en tiempo real (dato oportuno)
    Recibe la clave de la serie
    Regresa un diccionario con serie, titulo y datos (con un solo dato)
    Si algo falla regresa None
    """
    response = conexion_banxico(f"{serie}/datos/oportuno")
    if response is None:
        return None
    return leer_respuesta(response, serie)


def consultar_historico(serie: str, fecha_ini: datetime, fecha_fin: datetime):
    """
    Funcion 4: consulta una serie de banxico en un rango de fechas (datos historicos)
    Recibe la clave de la serie y las fechas inicial y final (datetime)
    Regresa un diccionario con serie, titulo y datos (todos los del rango)
    Si algo falla regresa None
    """
    ini = fecha_ini.strftime("%Y-%m-%d")
    fin = fecha_fin.strftime("%Y-%m-%d")
    response = conexion_banxico(f"{serie}/datos/{ini}/{fin}")
    if response is None:
        return None
    return leer_respuesta(response, serie)


def calcular_isc(capital: float, tasa_anual: float, dias: float) -> float:
    """
    Funcion 5: formula del interes simple con la tasa de cetes
    I = C * i * t
    C = capital
    i = tasa anual en decimal (tasa / 100)
    t = tiempo en anios (dias / 360)
    Regresa el interes ganado
    """
    return capital * (tasa_anual / 100) * (dias / 360)


def generar_reporte_consulta(consulta: dict, tipo: str, rango=None, limite=None) -> str:
    """
    Funcion 6: genera el reporte de una consulta de banxico
    Recibe la consulta, el tipo (datos oportunos o datos historicos),
    el rango de fechas (solo historicos) y el limite de datos a mostrar (None = todos)
    Regresa el reporte en texto listo para imprimir o enviar por email
    """
    ahora = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
    datos = consulta["datos"]
    lineas = [
        f"=== Reporte de Consulta Banxico ({tipo}) ===",
        f"Fecha del reporte: {ahora}",
        f"Consulta: {consulta['nombre']}",
        f"Serie: {consulta['serie']}",
        f"Descripcion: {consulta['titulo']}",
    ]
    if tipo == "datos oportunos":
        lineas.append(f"Fecha del dato: {datos[0]['fecha']}")
        lineas.append(f"Dato: {datos[0]['dato']}")
    else:
        lineas.append(f"Periodo: {rango[0]} al {rango[1]}")
        lineas.append(f"Total de datos: {len(datos)}")
        valores = [a_numero(d["dato"]) for d in datos]
        valores = [v for v in valores if v is not None]
        if valores:
            lineas.append(f"Minimo: {min(valores):,.4f}")
            lineas.append(f"Maximo: {max(valores):,.4f}")
            lineas.append(f"Promedio: {sum(valores) / len(valores):,.4f}")
        mostrados = datos if limite is None else datos[-limite:]
        lineas.append("")
        if limite is not None and len(datos) > limite:
            lineas.append(f"Ultimos {limite} datos del periodo:")
        else:
            lineas.append("Datos del periodo:")
        for d in mostrados:
            lineas.append(f"{d['fecha']}: {d['dato']}")
    return "\n".join(lineas) + "\n"


def generar_reporte_isc(consulta: dict, tasa: float, capital: float, dias: float, interes: float) -> str:
    """
    Funcion 7: genera el reporte del interes simple
    Recibe la consulta de cetes, la tasa, el capital, los dias y el interes
    Regresa el reporte en texto listo para imprimir o enviar por email
    """
    monto_final = capital + interes
    ahora = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
    reporte = (
        "=== Reporte de Interes Simple (ISC) ===\n"
        f"Fecha del reporte: {ahora}\n"
        f"Serie consultada: {consulta['serie']}\n"
        f"Descripcion: {consulta['titulo']}\n"
        f"Fecha del dato: {consulta['datos'][0]['fecha']}\n"
        f"Tasa anual de cetes a 28 dias: {tasa} %\n"
        f"Capital: ${capital:,.2f}\n"
        f"Plazo: {dias:g} dias\n"
        "Formula: I = C * i * t\n"
        f"Interes simple: ${interes:,.2f}\n"
        f"Monto final: ${monto_final:,.2f}\n"
    )
    return reporte


def enviar_email(destinatario: str, asunto: str, reporte: str) -> bool:
    """
    Funcion 8: envia el reporte por email con las claves del archivo .env
    Recibe el correo destino, el asunto y el texto del reporte
    Regresa True si se envio, False si hubo algun error
    """
    if not (EMAIL and PASSWORD and SERVERMAIL):
        print("Faltan EMAIL, PASSWORD o SERVERMAIL en el archivo .env")
        return False

    mensaje = EmailMessage()
    mensaje["Subject"] = asunto
    mensaje["From"] = f"{USERMAIL} <{EMAIL}>"
    mensaje["To"] = destinatario
    mensaje.set_content(reporte)

    try:
        with SMTP(SERVERMAIL, PORTMAIL, timeout=30) as servidor:
            servidor.starttls()
            servidor.login(EMAIL, PASSWORD)
            servidor.send_message(mensaje)
        return True
    except SMTPAuthenticationError:
        print("Usuario o password incorrectos (en gmail se usa contrasena de aplicacion)")
    except SMTPException as error:
        print(f"Error de SMTP al enviar el correo: {error}")
    except OSError as error:
        print(f"No se pudo conectar al servidor de correo: {error}")
    return False


def ofrecer_envio(asunto: str, reporte: str):
    """
    Funcion 9: pregunta al usuario si quiere enviar el reporte por email
    Si dice que si, pide el correo destino, espera el delay y envia el reporte
    Recibe el asunto y el reporte completo
    """
    while True:
        respuesta = input("Deseas enviar el reporte por email? (S/N): ").strip().upper()
        if respuesta in ("S", "SI", "N", "NO"):
            break
        print("Escribe S para si o N para no")
    if respuesta in ("N", "NO"):
        print("Reporte no enviado\n")
        return

    while True:
        destinatario = input("Escribe el correo destino (o escribe cancelar): ").strip()
        if destinatario.lower() == "cancelar":
            print("Reporte no enviado\n")
            return
        if re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", destinatario):
            break
        print("El correo no es valido")

    print("Enviando el reporte por email, espera un momento...")
    t.sleep(DELAY_REPORTE)
    if enviar_email(destinatario, asunto, reporte):
        print(f"Reporte enviado a {destinatario}\n")
    else:
        print("No se pudo enviar el reporte\n")


def a_numero(texto):
    """
    Funcion 10: convierte un dato de banxico a numero (quita las comas de miles)
    Recibe el dato en texto
    Regresa el numero como float o None si no es un numero (por ejemplo N/E)
    """
    try:
        return float(str(texto).replace(",", ""))
    except ValueError:
        return None


def pedir_numero(mensaje: str, minimo: float = 0) -> float:
    """
    Funcion 11: pide un numero al usuario y repite la pregunta hasta que sea valido
    Recibe el mensaje a mostrar y el minimo (el numero debe ser mayor a el)
    Regresa el numero como float
    """
    while True:
        try:
            numero = float(input(mensaje))
            if numero > minimo:
                return numero
            print(f"El numero debe ser mayor a {minimo}")
        except ValueError:
            print("Escribe solo numeros")


def pedir_rango_fechas():
    """
    Funcion 12: pide la fecha inicial y la final en formato dd/mm/aaaa
    Repite la pregunta hasta que las fechas sean validas y la inicial no sea mayor a la final
    Regresa las dos fechas como datetime
    """
    while True:
        try:
            fecha_ini = datetime.strptime(input("Fecha inicial (dd/mm/aaaa): ").strip(), "%d/%m/%Y")
            fecha_fin = datetime.strptime(input("Fecha final (dd/mm/aaaa): ").strip(), "%d/%m/%Y")
        except ValueError:
            print("Fecha invalida, usa el formato dd/mm/aaaa")
            continue
        if fecha_ini > fecha_fin:
            print("La fecha inicial no puede ser mayor a la final")
            continue
        return fecha_ini, fecha_fin


def elegir_serie():
    """
    Funcion 13: muestra el menu de series y pide una opcion
    Regresa el diccionario de la serie elegida o None si el usuario regresa
    """
