    for numero, info in SERIES.items():
        print(f"{numero} {info['nombre']}")
    print("0 Regresar")
    while True:
        try:
            opcion = int(input())
        except ValueError:
            print("Debes seleccionar una opcion.")
            continue
        if opcion == 0:
            return None
        if opcion in SERIES:
            return SERIES[opcion]
        print("Debes seleccionar una opcion.")


def menu_consultas():
    """
    Funcion 14: menu de consultas de banxico
    Permite elegir datos oportunos o datos historicos y despues la serie
    Al terminar cada consulta ofrece enviar el reporte por email
    """
    while True:
        print("\nConsulta Banxico")
        print("1 Datos oportunos (ultimo dato publicado)")
        print("2 Datos historicos (rango de fechas)")
        print("3 Regresar al menu")
        try:
            opcionConsulta = int(input())
        except ValueError:
            print("Debes seleccionar una opcion.")
            continue

        # Datos oportunos
