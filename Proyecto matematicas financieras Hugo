            info = elegir_serie()
            if info is None:
                continue
            consulta = consultar_oportuno(info["serie"])
            if consulta is None:
                continue
            consulta["nombre"] = info["nombre"]
            reporte = generar_reporte_consulta(consulta, "datos oportunos")
            print("\n" + reporte)
            ofrecer_envio(f"Reporte Banxico: {info['nombre']} (datos oportunos)", reporte)

        # Datos historicos
        elif opcionConsulta == 2:
            info = elegir_serie()
            if info is None:
                continue
            fecha_ini, fecha_fin = pedir_rango_fechas()
            consulta = consultar_historico(info["serie"], fecha_ini, fecha_fin)
            if consulta is None:
                continue
            consulta["nombre"] = info["nombre"]
            rango = (fecha_ini.strftime("%d/%m/%Y"), fecha_fin.strftime("%d/%m/%Y"))
            # En pantalla solo los ultimos datos, en el email todos
            print("\n" + generar_reporte_consulta(consulta, "datos historicos", rango, DATOS_HISTORICOS_MOSTRAR))
            reporte = generar_reporte_consulta(consulta, "datos historicos", rango)
            ofrecer_envio(f"Reporte Banxico: {info['nombre']} (datos historicos)", reporte)

        elif opcionConsulta == 3:
            break

        else:
            print("Debes seleccionar una opcion.")


def flujo_isc():
    """
    Funcion 15: flujo completo del calculo del ISC
    Pide capital y plazo, consulta la tasa de cetes a 28 dias, resuelve la formula,
    genera el reporte y ofrece enviarlo por email
    """
    print("Bienvenido a Calculo de ISC")
    print("Formula: I = C * i * t")
    capital = pedir_numero("Escribe el capital: ")
    dias = pedir_numero("Escribe el plazo en dias: ")

    # Consulta la serie adecuada (cetes a 28 dias)
    consulta = consultar_oportuno(SERIE_CETES28)
    if consulta is None:
        print("No se pudo obtener la tasa de cetes, intenta mas tarde\n")
        return
    tasa = a_numero(consulta["datos"][0]["dato"])
    if tasa is None:
        print("Banxico no tiene un dato disponible para la serie\n")
        return

    # Resuelve la formula y genera el reporte
    interes = calcular_isc(capital, tasa, dias)
    reporte = generar_reporte_isc(consulta, tasa, capital, dias, interes)
    print("\n" + reporte)
    ofrecer_envio("Reporte ISC con tasa de Cetes a 28 dias", reporte)


